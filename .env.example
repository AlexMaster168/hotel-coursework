NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/hotel?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
# Optional; real Stripe account, or test keys for sandbox payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Demo creates a temporary local database and demo accounts. Never enable in production.
DEMO_MODE=false
# Seed creates an administrator only when both values are provided.
ADMIN_EMAIL=
ADMIN_PASSWORD=
