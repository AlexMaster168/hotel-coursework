{
  "name": "hotel-booking",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm start -w server",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client",
    "test": "npm test -w server",
    "test:e2e": "playwright test",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "concurrently": "10.0.6"
  }
}
